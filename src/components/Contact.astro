<section
  id="contact"
  class="flex items-center justify-center h-[100dvh] w-full bg-[oklch(var(--primary-background))] text-[oklch(var(--foreground))]"
>
  <form
    id="contact-form"
    class="relative drop-shadow-lg drop-shadow-[oklch(var(--card))]/90 flex items-center justify-center flex-col bg-[oklch(var(--primary-background))] w-[70vw] h-[90vh] lg:w-1/2 rounded-2xl"
  >
    <div class="text-center space-y-8">
      <h2 class="text-2xl mt-2">Contactame</h2>
      <div class="text-center pb-3">
        <div class="grid grid-cols-1 gap-x-6 gap-y-2 sm:grid-cols-6">
          <div class="sm:col-span-12">
            <label for="first-name" class="block text-md font-medium text-start"
              >nombre</label
            >
            <div class="mt-2">
              <input
                id="first-name"
                type="text"
                name="name"
                maxlength="60"
                autocomplete="given-name"
                required
                class="block sm:w-full w-[50vw] rounded-md bg-[oklch(var(--primary-background))]/60 px-3 py-1.5 text-base outline-1 -outline-offset-1 outline-[oklch(var(--foreground))]/20 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-[oklch(var(--foreground))]/30 sm:text-md"
              />
            </div>
          </div>

          <div class="sm:col-span-6">
            <label for="last-name" class="block text-md font-medium text-start"
              >apellido</label
            >
            <div class="mt-2">
              <input
                id="last-name"
                type="text"
                name="last-name"
                maxlength="60"
                autocomplete="family-name"
                required
                class="block sm:w-full w-[50vw] rounded-md bg-[oklch(var(--primary-background))]/60 px-3 py-1.5 text-base outline-1 -outline-offset-1 outline-[oklch(var(--foreground))]/20 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-[oklch(var(--foreground))]/30 sm:text-md"
              />
            </div>
          </div>

          <div class="sm:col-span-6">
            <label for="subject" class="block text-md font-medium text-start"
              >Asunto</label
            >
            <div class="mt-2">
              <input
                id="subject"
                type="text"
                name="subject"
                autocomplete="off"
                maxlength="120"
                required
                class="block sm:w-full w-[50vw] rounded-md bg-[oklch(var(--primary-background))]/60 px-3 py-1.5 text-base outline-1 -outline-offset-1 outline-[oklch(var(--foreground))]/20 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-[oklch(var(--foreground))]/30 sm:text-md"
              />
            </div>
          </div>

          <div class="sm:col-span-6">
            <label for="email" class="block text-md font-medium text-start">Email</label>
            <div class="mt-2">
              <input
                id="email"
                type="email"
                name="email"
                maxlength="254"
                autocomplete="email"
                required
                class="block sm:w-full w-[50vw] rounded-md bg-[oklch(var(--primary-background))]/60 px-3 py-1.5 text-base outline-1 -outline-offset-1 outline-[oklch(var(--foreground))]/20 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-[oklch(var(--foreground))]/30 sm:text-md"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="sm:col-span-full">
      <label for="message" class="block text-md font-medium text-start">Mensaje</label>
      <div class="mt-2">
        <textarea
          id="message"
          name="message"
          maxlength="5000"
          rows="7"
          required
          class="sm:w-100 w-[50vw] rounded-md bg-[oklch(var(--primary-background))]/60 px-3 py-1.5 text-base outline-1 -outline-offset-1 outline-[oklch(var(--foreground))]/20 placeholder:text-[oklch(var(--foreground))] focus:outline-2 focus:-outline-offset-2 focus:outline-[oklch(var(--foreground))]/30"
        ></textarea>
      </div>
    </div>
    <!-- Honeypot anti-spam: oculto para personas, los bots suelen completarlo -->
    <div class="absolute size-px overflow-hidden opacity-0 pointer-events-none" aria-hidden="true">
      <label for="website">No completar este campo</label>
      <input id="website" type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <p id="form-status" class="mt-4 text-sm min-h-5" role="status" aria-live="polite"></p>
    <div class="mt-2 flex items-center justify-center gap-x-6">
      <button
        type="reset"
        class="font-bold bg-[oklch(var(--secondary-background))] rounded-md px-3 py-2 text-sm"
      >
        Cancelar
      </button>
      <button
        id="submit-button"
        type="submit"
        class="border rounded-md px-3 py-2 text-sm font-bold disabled:opacity-50 disabled:cursor-wait"
      >
        Enviar
      </button>
    </div>
  </form>
</section>

<script>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("form-status");
  const submitButton = document.getElementById("submit-button");

  if (form instanceof HTMLFormElement) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
      if (status) status.textContent = "Enviando...";

      try {
        const res = await fetch("/api/mail", {
          method: "POST",
          body: new FormData(form),
        });
        const result = await res.json().catch(() => ({}));

        if (res.ok && result.success) {
          window.location.href = "/enviado";
          return;
        }
        if (status) status.textContent = result.error ?? "Error enviando el mensaje";
      } catch {
        if (status) status.textContent = "No se pudo conectar. Intentá de nuevo.";
      }

      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
    });

    form.addEventListener("reset", () => {
      if (status) status.textContent = "";
    });
  }
</script>
