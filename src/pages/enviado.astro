---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Mensaje enviado | Nicolas Urbanski" noindex>
  <main class="h-screen w-full bg-black flex flex-col justify-center items-center">
    <div class="md:w-[65vw] w-full">
      <h1 class="sm:text-9xl text-7xl font-bold text-white/90 p-6 border-b-4 border-white/10">
        Mensaje enviado con éxito
      </h1>
      <div class="size-15 bg-white/90 m-5 rounded-full"></div>
    </div>
  </main>

  <script>
    setTimeout(() => {
      window.location.href = "/";
    }, 3000);
  </script>
</Layout>
